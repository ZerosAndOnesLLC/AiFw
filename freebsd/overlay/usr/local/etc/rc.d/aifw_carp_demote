#!/bin/sh
#
# PROVIDE: aifw_carp_demote
# REQUIRE: FILESYSTEMS kld
# BEFORE: netif pfsync pf
# KEYWORD: nojail
#
# Early-boot CARP hold for HA nodes (#712): enables preemption and places a
# `boot` demotion before any interface or VIP comes up. aifw-daemon releases
# it once pf rules are loaded and pfsync's bulk update has completed, so a
# rebooted node can't take MASTER back with an empty state table. Also
# re-applies persistent maintenance mode.
#

. /etc/rc.subr

name="aifw_carp_demote"
rcvar=aifw_carp_demote_enable
load_rc_config $name
: ${aifw_carp_demote_enable:=NO}

start_cmd="aifw_carp_demote_start"
stop_cmd=":"

aifw_carp_demote_start() {
    if [ "$(sysrc -n aifw_cluster_enabled 2>/dev/null)" = "YES" ]; then
        /usr/local/libexec/aifw-sudo-carp boot || \
            echo "aifw_carp_demote: boot hold failed; CARP may preempt before state sync" >&2
    fi
}

run_rc_command "$1"
